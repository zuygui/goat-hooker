---
// Landing page. It doesn't use the layout of Starlight, to control the whole page; it shares
// its theme key ("starlight-theme") so that the docs open in the same theme.

import { readFileSync } from "node:fs";
import bench from "../data/benchmarks.json";
import {
  compareTools,
  compareCommon,
  compareOnly,
  tools,
  features,
  highlightToml,
  YES,
  PART,
} from "../data/content";

const base = "/goat-hooker/";
const repository = "https://github.com/zuygui/goat-hooker";
// The build runs from site/: the repository is its parent
const root = new URL("../", `file://${process.cwd()}/`);

// Version and release notes, read from the repository at build time
const cargo = readFileSync(new URL("Cargo.toml", root), "utf8");
const version = cargo.match(/^version\s*=\s*"([^"]+)"/m)?.[1] ?? "";
const changelog = readFileSync(new URL("CHANGELOG.md", root), "utf8");
const release = changelog.match(/^## \[(\d+\.\d+\.\d+)\][^\n]*?(\d{4}-\d{2}-\d{2})\n([\s\S]*?)(?=^## \[)/m);
const releaseVersion = release?.[1] ?? version;
const releaseDate = release
  ? new Date(release[2]).toLocaleDateString("en-US", { month: "long", year: "numeric" })
  : "";
const releaseNotes = (release?.[3] ?? "")
  .split(/^### /m)
  .filter((section) => /^(Added|Fixed|Changed)/.test(section))
  .flatMap((section) => section.split("\n").filter((line) => line.startsWith("- ")))
  .map((line) => {
    const text = line.slice(2);
    const app = text.startsWith("*(gui)* ");
    return { app, text: app ? text.slice(8) : text };
  })
  .slice(0, 8);

// Benchmark charts, from benchmarks/results.json
const order = ["goat-hooker", "lefthook", "prek", "pre-commit", "husky + lint-staged"];
const names: Record<string, string> = { "goat-hooker": "Goat Hooker" };
const versionOf = (tool: string) => {
  const v = bench.versions as Record<string, string>;
  const raw = tool === "husky + lint-staged" ? v.husky : v[tool];
  return raw?.match(/\d+\.\d+(\.\d+)?/)?.[0] ?? "";
};
const charts = [
  {
    id: "noop",
    title: "One hook that does nothing",
    caption: `The cost of the tool itself, on top of git commit (${(bench.scenarios as any).noop.none} ms alone).`,
  },
  {
    id: "five",
    title: "Five hooks of 200 ms",
    caption: "How the hooks are scheduled. prek and pre-commit run them one after the other.",
  },
  { id: "many", title: "1,000 staged files", caption: "Five hooks matching them: the files are matched in a few milliseconds." },
  {
    id: "retry",
    title: "The same commit again",
    caption: "After a rejected commit message: same staged files, hooks already passed.",
  },
].map((chart) => {
  const values = (bench.scenarios as Record<string, Record<string, number>>)[chart.id];
  const rows = order.filter((tool) => tool in values).map((tool) => ({ tool, ms: values[tool] }));
  const top = Math.max(...rows.map((r) => r.ms));
  return {
    ...chart,
    rows: rows.map((r) => ({
      ...r,
      name: names[r.tool] ?? r.tool,
      version: versionOf(r.tool),
      width: Math.max(1.5, (r.ms / top) * 100),
      ours: r.tool === "goat-hooker",
    })),
  };
});
const retry = (bench.scenarios as any).retry;
const retryFactor = Math.round(retry.lefthook / retry["goat-hooker"]);

const install = [
  { id: "curl", label: "macOS & Linux", command: "curl -fsSL https://raw.githubusercontent.com/zuygui/goat-hooker/main/install.sh | sh" },
  { id: "brew", label: "Homebrew", command: "brew install zuygui/tap/goat-hooker" },
  { id: "cargo", label: "Cargo", command: "cargo binstall goat-hooker" },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Goat Hooker · Git hooks that only run what changed</title>
    <meta
      name="description"
      content="Goat Hooker is a fast Git hooks manager for mono-repos: it runs only what changed, caches the results, runs hooks in parallel and comes with a desktop app."
    />
    <meta property="og:title" content="Goat Hooker · Git hooks that only run what changed" />
    <meta property="og:description" content="A fast Git hooks manager for mono-repos, with a cache and a desktop app." />
    <link rel="icon" type="image/png" href={`${base}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="announce">
      <a href={`${repository}/releases/tag/v${releaseVersion}`}>
        <span class="pill">New</span> Goat Hooker v{releaseVersion}: watch, doctor, affected projects and a command palette <span aria-hidden="true">→</span>
      </a>
    </div>

    <header class="nav">
      <div class="wrap nav-inner">
        <a href={base} class="brand">
          <img src={`${base}goat.png`} alt="" width="34" height="34" />
          <span>Goat Hooker</span>
        </a>
        <nav class="nav-links">
          <a href={`${base}docs/`}>Docs</a>
          <a href={`${base}docs/quickstart/`}>Quickstart</a>
          <a href={`${base}docs/configuration/`}>Config</a>
          <a href={`${base}docs/cli/`}>CLI</a>
          <a href="#benchmarks">Benchmarks</a>
        </nav>
        <div class="nav-actions">
          <a class="gh" href={repository} target="_blank" rel="noopener" aria-label="GitHub">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.39.6.1.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 24 12c0-6.63-5.37-12-12-12Z"/></svg>
          </a>
          <a class="btn btn-small" href="#install">Install</a>
        </div>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="hero">
        <div class="wrap hero-inner">
          <img class="hero-goat" src={`${base}goat.png`} alt="The goat of Goat Hooker" width="150" height="150" />
          <h1>
            Goat Hooker is a fast Git hooks manager.
            <span class="accent">Built for mono-repos.</span>
          </h1>
          <p class="lede">
            It runs only the hooks your changes need, takes the rest from its cache, runs them in
            parallel, and comes with a desktop app. One native binary, nothing else to install.
          </p>
          <div class="cta">
            <a class="btn" href="#install">Install Goat Hooker v{version}</a>
            <a class="btn btn-ghost" href={`${base}docs/quickstart/`}>Quickstart</a>
            <a class="btn btn-ghost" href={`${base}docs/`}>Read the docs</a>
          </div>

          <div class="install" id="install">
            <div class="tabs" role="tablist">
              {install.map((item, i) => (
                <button class:list={["tab", { active: i === 0 }]} data-group="install" data-tab={item.id} role="tab">{item.label}</button>
              ))}
              <a class="tab tab-link" href={`${repository}/releases/latest`} target="_blank" rel="noopener">Desktop app ↗</a>
            </div>
            {install.map((item, i) => (
              <div class:list={["install-line", { active: i === 0 }]} data-group="install" data-panel={item.id}>
                <code><span class="prompt">$</span> {item.command}</code>
                <button class="copy" data-copy={item.command} aria-label="Copy">Copy</button>
              </div>
            ))}
            <a class="install-script" href={`${repository}/blob/main/install.sh`} target="_blank" rel="noopener">View install script ↗</a>
          </div>
        </div>
      </section>

      <!-- Benchmarks -->
      <section class="section" id="benchmarks">
        <div class="wrap">
          <p class="eyebrow">Benchmarks</p>
          <h2>Fast where it counts: the moment you commit.</h2>
          <p class="section-lede">
            Time of a <code>git commit</code>, median of {bench.runs} runs, lower is better. Goat Hooker
            adds less than half of what lefthook and prek add, runs hooks in parallel, and a commit
            retried with the same files is {retryFactor}× faster because the hooks come from the cache.
          </p>
          <div class="charts">
            {charts.map((chart) => (
              <figure class="chart">
                <figcaption>
                  <h3>{chart.title}</h3>
                  <p>{chart.caption}</p>
                </figcaption>
                <div class="bars">
                  {chart.rows.map((row) => (
                    <div class:list={["bar-row", { ours: row.ours }]}>
                      <span class="bar-name">{row.name} <span class="bar-version">{row.version}</span></span>
                      <span class="bar-track">
                        <span class="bar" style={`--w: ${row.width}%`}></span>
                        <span class="bar-value">{row.ms} ms</span>
                      </span>
                    </div>
                  ))}
                </div>
              </figure>
            ))}
          </div>
          <p class="footnote">
            {bench.versions.git}, a 2-core Linux VM, with each tool installed as its docs show.
            <a href={`${repository}/blob/main/benchmarks/README.md`}>Methodology and how to reproduce →</a>
          </p>
        </div>
      </section>

      <!-- Tools -->
      <section class="section section-alt" id="tools">
        <div class="wrap">
          <p class="eyebrow">One binary</p>
          <h2>Everything your hooks need, in <code>hooker</code>.</h2>
          <nav class="jump">
            {tools.map((tool) => <a href={`#${tool.id}`}>{tool.command}</a>)}
          </nav>
          <div class="tools">
            {tools.map((tool) => (
              <article class="tool" id={tool.id}>
                <div class="tool-text">
                  <code class="tool-command">{tool.command}</code>
                  <h3>{tool.title}</h3>
                  <p class="replaces">replaces <strong>{tool.replaces}</strong></p>
                  <p>{tool.text}</p>
                  <a class="more" href={tool.doc}>Docs →</a>
                </div>
                <pre class="term"><code>{tool.term.map(([mark, line]) => (
                  <span class="term-line"><span class:list={["mark", {
                    ok: mark.startsWith("✔"),
                    ko: mark.startsWith("✘"),
                    warn: mark.startsWith("!"),
                    prompt: mark.startsWith("$"),
                    hint: mark.startsWith("→"),
                  }]}>{mark}</span>{line}{"\n"}</span>
                ))}</code></pre>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Built in -->
      <section class="section" id="features">
        <div class="wrap">
          <p class="eyebrow">Built in</p>
          <h2>What other hooks managers leave to you.</h2>
          <div class="tabs tabs-features" role="tablist">
            {features.map((feature, i) => (
              <button class:list={["tab", { active: i === 0 }]} data-group="feature" data-tab={feature.id} role="tab">{feature.label}</button>
            ))}
          </div>
          {features.map((feature, i) => (
            <div class:list={["feature", { active: i === 0 }]} data-group="feature" data-panel={feature.id}>
              <div class="feature-text">
                <h3>{feature.title}</h3>
                <p>{feature.text}</p>
              </div>
              <div class="code-card">
                <div class="code-file">{feature.file}</div>
                <pre><code set:html={highlightToml(feature.code)} /></pre>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Compare -->
      <section class="section section-alt" id="compare">
        <div class="wrap">
          <p class="eyebrow">Compare</p>
          <h2>Goat Hooker, lefthook, prek, pre-commit and husky.</h2>
          <div class="table-wrap">
            <table class="compare">
              <thead>
                <tr>
                  <th></th>
                  {compareTools.map((tool, i) => <th class:list={{ ours: i === 0 }}>{tool}</th>)}
                </tr>
              </thead>
              <tbody>
                <tr class="group"><td colspan="6">Everyday hooks</td></tr>
                {compareCommon.map(([label, marks]) => (
                  <tr>
                    <td>{label}</td>
                    {marks.map((mark, i) => (
                      <td class:list={["mark-cell", { ours: i === 0 }]}>
                        <span class:list={["m", mark === YES ? "m-yes" : mark === PART ? "m-part" : "m-no"]} title={mark === YES ? "Built in" : mark === PART ? "Partly, or with another tool" : "No"}></span>
                      </td>
                    ))}
                  </tr>
                ))}
                <tr class="group"><td colspan="6">Only in Goat Hooker</td></tr>
                {compareOnly.map((label) => (
                  <tr>
                    <td>{label}</td>
                    {compareTools.map((_, i) => (
                      <td class:list={["mark-cell", { ours: i === 0 }]}>
                        <span class:list={["m", i === 0 ? "m-yes" : "m-no"]}></span>
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="footnote">
            <span class="m m-yes"></span> built in &nbsp; <span class="m m-part"></span> partly, or with another tool &nbsp; <span class="m m-no"></span> no.
            Spotted a mistake? <a href={`${repository}/issues/new`}>Open an issue →</a>
          </p>
        </div>
      </section>

      <!-- App -->
      <section class="section" id="app">
        <div class="wrap">
          <p class="eyebrow">Desktop app</p>
          <h2>Prefer clicking? There's an app.</h2>
          <p class="section-lede">
            See what the next commit will run, run a hook and read its output live, edit hooks
            without touching the config file, and wire them together like nodes in Blender.
            ⌘K reaches everything.
          </p>
          <div class="shots">
            <img src={`${base}app-dark.png`} alt="The hooks of a mono-repo, with the files each one will check and its last run" />
            <img src={`${base}graph-dark.png`} alt="The pre-commit hooks as a graph of nodes" />
          </div>
          <a class="more" href={`${repository}/releases/latest`}>Download for macOS, Windows and Linux →</a>
        </div>
      </section>

      <!-- Release notes -->
      <section class="section section-alt" id="release">
        <div class="wrap release">
          <div>
            <p class="eyebrow">Release notes</p>
            <h2>v{releaseVersion}</h2>
            <p class="release-date">{releaseDate}</p>
            <pre class="term term-small"><code><span class="mark prompt">$ </span>cargo binstall goat-hooker</code></pre>
          </div>
          <div>
            <ul class="notes">
              {releaseNotes.map((note) => (
                <li>{note.app && <span class="note-tag">app</span>}{note.text}</li>
              ))}
            </ul>
            <a class="more" href={`${repository}/blob/main/CHANGELOG.md`}>Full changelog →</a>
          </div>
        </div>
      </section>

      <!-- Closing -->
      <section class="closing">
        <div class="wrap">
          <img src={`${base}goat.png`} alt="" width="96" height="96" />
          <h2>Try it on the repository you have open right now.</h2>
          <div class="install-line active closing-line">
            <code><span class="prompt">$</span> {install[0].command}</code>
            <button class="copy" data-copy={install[0].command} aria-label="Copy">Copy</button>
          </div>
          <p class="closing-sub">Then <code>hooker init</code> and <code>hooker install</code>. Already on husky, lefthook or pre-commit? <code>hooker import</code>.</p>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <a href={base} class="brand">
            <img src={`${base}goat.png`} alt="" width="30" height="30" />
            <span>Goat Hooker</span>
          </a>
          <p>Git hooks that only run what changed.</p>
        </div>
        <div class="footer-cols">
          <div>
            <h4>Product</h4>
            <a href={`${base}docs/quickstart/`}>Quickstart</a>
            <a href={`${base}docs/`}>Documentation</a>
            <a href={`${repository}/releases/latest`}>Download the app</a>
            <a href={`${repository}/blob/main/CHANGELOG.md`}>Changelog</a>
          </div>
          <div>
            <h4>Toolkit</h4>
            <a href={`${base}docs/cli/`}>hooker CLI</a>
            <a href={`${base}docs/configuration/`}>Configuration</a>
            <a href={`${base}docs/monorepos/`}>Mono-repos</a>
            <a href={`${base}docs/shared-hooks/`}>Shared hooks</a>
          </div>
          <div>
            <h4>Project</h4>
            <a href={repository}>GitHub</a>
            <a href={`${repository}/issues`}>Issues</a>
            <a href={`${repository}/blob/main/benchmarks/README.md`}>Benchmarks</a>
            <a href={`${repository}/blob/main/CONTRIBUTING.md`}>Contributing</a>
          </div>
        </div>
      </div>
      <p class="wrap legal">Made with 🐐 · MIT licensed</p>
    </footer>

    <script is:inline>
      // Tabs: buttons and panels sharing data-group, matched by data-tab / data-panel
      document.querySelectorAll("button.tab[data-group]").forEach((button) => {
        button.addEventListener("click", () => {
          const group = button.dataset.group;
          document.querySelectorAll(`[data-group="${group}"]`).forEach((el) => {
            const id = el.dataset.tab ?? el.dataset.panel;
            el.classList.toggle("active", id === button.dataset.tab);
          });
        });
      });
      document.querySelectorAll("button.copy").forEach((button) => {
        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy);
            button.textContent = "Copied";
            setTimeout(() => (button.textContent = "Copy"), 1500);
          } catch {}
        });
      });
      // The docs open in the dark theme of this page
      try {
        if (!localStorage.getItem("starlight-theme")) localStorage.setItem("starlight-theme", "dark");
      } catch {}
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0f0d0e;
    --bg-alt: #151213;
    --card: #1a1718;
    --card-2: #211d1e;
    --line: rgba(255, 255, 255, 0.08);
    --line-strong: rgba(255, 255, 255, 0.14);
    --text: #f7f2f3;
    --muted: #a39a9c;
    --dim: #6f6567;
    --pink: #f3678b;
    --pink-soft: rgba(243, 103, 139, 0.14);
    --teal: #65dddb;
    --gray-bar: #3b3537;
    --mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    color-scheme: dark;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.6 "Inter", system-ui, -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  code {
    font-family: var(--mono);
    font-size: 0.92em;
  }

  p code,
  h2 code {
    background: rgba(255, 255, 255, 0.06);
    padding: 0.1em 0.35em;
    border-radius: 6px;
  }

  .wrap {
    width: min(1120px, 100% - 48px);
    margin-inline: auto;
  }

  /* Announcement and navigation */
  .announce {
    text-align: center;
    font-size: 14px;
    padding: 9px 16px;
    background: linear-gradient(90deg, rgba(243, 103, 139, 0.16), rgba(101, 221, 219, 0.12));
    border-bottom: 1px solid var(--line);
  }

  .announce a:hover {
    text-decoration: underline;
  }

  .pill {
    display: inline-block;
    background: var(--pink);
    color: #1a0b10;
    font-weight: 700;
    font-size: 12px;
    padding: 1px 8px;
    border-radius: 99px;
    margin-right: 6px;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(15, 13, 14, 0.8);
    backdrop-filter: blur(14px) saturate(150%);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 18px;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    gap: 24px;
    font-size: 15px;
    color: var(--muted);
  }

  .nav-links a:hover,
  .gh:hover {
    color: var(--text);
  }

  .nav-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .gh {
    color: var(--muted);
    display: flex;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--pink);
    color: #1a0b10;
    font-weight: 700;
    padding: 12px 22px;
    border-radius: 12px;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(243, 103, 139, 0.3);
  }

  .btn-small {
    padding: 7px 14px;
    font-size: 14px;
    border-radius: 10px;
  }

  .btn-ghost {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--line-strong);
  }

  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.04);
    box-shadow: none;
  }

  /* Hero */
  .hero {
    position: relative;
    padding: 72px 0 88px;
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: -40% -10% auto;
    height: 640px;
    background: radial-gradient(closest-side, rgba(243, 103, 139, 0.18), transparent 70%),
      radial-gradient(closest-side at 70% 60%, rgba(101, 221, 219, 0.1), transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    text-align: center;
  }

  .hero-goat {
    animation: hop 3.2s ease-in-out infinite;
    filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.45));
  }

  @keyframes hop {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-10px) rotate(2deg); }
  }

  h1 {
