{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goat Hooker config",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "JSON schema of the file",
      "type": [
        "string",
        "null"
      ]
    },
    "discover": {
      "description": "Load every hooker.config.json of the repository (files ignored by git are skipped)",
      "type": [
        "boolean",
        "null"
      ]
    },
    "hooks": {
      "description": "Hooks of this project",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Hook"
      }
    },
    "imports": {
      "description": "Sub-projects folders, each one with its own hooker.config.json. Globs are supported (packages/*)",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "parallel": {
      "description": "Run hooks in parallel (root config only)",
      "type": [
        "boolean",
        "null"
      ]
    },
    "params": {
      "description": "Parameters of a reusable hooks file, used as `{{name}}` in its hooks and set with `with` by the hook loading it",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/Param"
      }
    }
  },
  "$defs": {
    "Hook": {
      "type": "object",
      "properties": {
        "cmd": {
          "description": "Shell command, run from the config folder. {files} is replaced by the targeted files",
          "type": [
            "string",
            "null"
          ]
        },
        "cmds": {
          "description": "Shell commands, run in order",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "description": "Glob patterns of files to ignore",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "from": {
          "description": "Git repository URL to load the hooks file from (requires `path`)",
          "type": [
            "string",
            "null"
          ]
        },
        "include": {
          "description": "Glob patterns, relative to the config folder. Without it, the hook targets all files",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "description": "Values from other hooks, available as `{name}` and `$name` in commands: `{ \"name\": \"hook.output\" }` (outputs: files, stdout, status or a declared output)",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "description": "Hook name",
          "type": "string"
        },
        "needs": {
          "description": "Hooks this one waits for: `name`, `name/step` or `project:name` (same trigger)",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "description": "Outputs this hook writes with `echo \"name=value\" >> $HOOKER_OUTPUT`",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "path": {
          "description": "Hooks file to load, relative to the config folder (or to the root of `from`)",
          "type": [
            "string",
            "null"
          ]
        },
        "rev": {
          "description": "Branch or tag of `from` (default branch if missing)",
          "type": [
            "string",
            "null"
          ]
        },
        "stage_fixed": {
          "description": "Re-stage the targeted files after the hook (for formatters)",
          "type": [
            "boolean",
            "null"
          ]
        },
        "steps": {
          "description": "Steps of this hook, each one can wait for the others",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Step"
          }
        },
        "trigger": {
          "description": "Git hook that runs this hook (not used with `path`)",
          "anyOf": [
            {
              "$ref": "#/$defs/Trigger"
            },
            {
              "type": "null"
            }
          ]
        },
        "with": {
          "description": "Values of the `params` of the hooks file loaded with `path`",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "name"
      ]
    },
    "Param": {
      "description": "A parameter of a reusable hooks file",
      "type": "object",
      "properties": {
        "default": {
          "description": "Value used when `with` doesn't set it (required without it)"
        },
        "description": {
          "description": "What the parameter is for",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Step": {
      "description": "A step of a hook: a node of the graph",
      "type": "object",
      "properties": {
        "cmd": {
          "description": "Shell command of the step",
          "type": "string"
        },
        "id": {
          "description": "Step id, unique in the hook",
          "type": "string"
        },
        "inputs": {
          "description": "Values from other steps or hooks: `{ \"name\": \"step.output\" }`",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "needs": {
          "description": "Steps (or hooks) this one waits for",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "description": "Outputs this step writes to $HOOKER_OUTPUT",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "cmd"
      ]
    },
    "Trigger": {
      "description": "Client-side Git hook",
      "type": "string",
      "enum": [
        "pre-commit",
        "prepare-commit-msg",
        "commit-msg",
        "post-commit",
        "pre-rebase",
        "post-rewrite",
        "pre-push",
        "applypatch-msg",
        "pre-applypatch",
        "post-applypatch",
        "pre-auto-gc",
        "post-checkout",
        "post-merge"
      ]
    }
  }
}
